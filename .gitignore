# Runtime data and private state (never commit)
/data/
/_global/
source_code/data/
*.tmp
logs.txt
source_code/logs.txt
sites/_global/logs.txt
sites/_global/ui/*
!sites/_global/ui/.gitkeep
sites/_global/logs/*
!sites/_global/logs/.gitkeep
sites/_global/memory/*
!sites/_global/memory/.gitkeep
sites/_global/settings/*
!sites/_global/settings/.gitkeep
sites/*/settings_override.json

# Build output and binaries
build/
source_code/build/
*.exe
*.dll
*.zip

# Node / verification output
node_modules/
source_code/node_modules/
source_code/verification-output/
coverage/

# Site runtime state: keep the folder markers, never the cookies/sessions
sites/*/accounts/*
!sites/*/accounts/.gitkeep
sites/*/profiles/*
!sites/*/profiles/.gitkeep
!sites/*/profiles/default/
sites/*/profiles/default/*
!sites/*/profiles/default/.gitkeep
sites/*/sessions/*
!sites/*/sessions/.gitkeep
sites/*/logs/*
!sites/*/logs/.gitkeep
*.log
*.jsonl.tmp

# OS noise
.DS_Store
Thumbs.db
desktop.ini
