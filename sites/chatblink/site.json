{
  "id": "chatblink",
  "name": "ChatBlink.com (Random Roulette \u0026 DM)",
  "family": "family_d",
  "account_mode": "auto_register",
  "enabled": true,
  "start_url": "https://www.chatblink.com/",
  "app_url": "https://www.chatblink.com/",
  "auth_mode": "dom_only",
  "entry_flow": "18+ Guest Login -\u003e Free Chat Roulette / Private DM",
  "protection_summary": "Long-running international guest chat; enforces anti-spam cooldown on repetitive messages.",
  "selectors": {
    "composer_input": "textarea:not([disabled]), input#content:not([disabled]), input#message_content:not([disabled]), input[type=\"text\"][placeholder*=\"message\" i]:not([disabled]), input[type=\"text\"][placeholder*=\"say\" i]:not([disabled])",
    "send_button": "button#submit_button, button[type=\"submit\"], button.send_btn, input[type=\"submit\"]",
    "skip_button": "button.disconnect, button.next-stranger, button.skip-btn, a.leave",
    "start_button": "button.start-chat, button#start, input[type=\"submit\"], button.connect",
    "message_history": "#chat_logs_container, .chat-logs, .messages, .logbox, #messages, main",
    "message_row": ".chat_log, .logitem, .message-row, .msg-item, li",
    "message_text": ".my_text, .chat_message, .message-text, p, span",
    "partner_message_selector": ".other_user, .strangermsg, .partner, .incoming, .them",
    "own_message_selector": ".me_user, .youmsg, .self, .outgoing, .mine",
    "partner_name": ".private_target, .partner-name, .stranger-name",
    "chat_ended_text": "disconnected|ended the chat|left the conversation"
  }
}