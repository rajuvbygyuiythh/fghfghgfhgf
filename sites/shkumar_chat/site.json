{
  "id": "shkumar_chat",
  "name": "OpenSource 1v1 Stranger Chat (GitHub)",
  "family": "family_e",
  "account_mode": "auto_register",
  "enabled": true,
  "start_url": "https://shkumaraman.github.io/chat/index.html",
  "app_url": "https://shkumaraman.github.io/chat/index.html",
  "auth_mode": "dom_only",
  "entry_flow": "Instant Anonymous 1v1 -\u003e Connected! Say Hi",
  "protection_summary": "Open-source GitHub Pages + WebSocket 1v1 stranger text chat; zero CAPTCHA, zero login.",
  "selectors": {
    "composer_input": "textarea:not([disabled]), input[type=\"text\"]:not([disabled])[placeholder*=\"message\" i], input[type=\"text\"]:not([disabled])[placeholder*=\"type\" i], #messageInput, #chatInput",
    "send_button": "button#sendBtn, button[type=\"submit\"], button.send-btn, button[aria-label*=\"Send\" i]",
    "skip_button": "button#skipBtn, button#nextBtn, button.skip-btn, button.next-btn, button[aria-keyshortcuts=\"Escape\"]",
    "start_button": "button#startBtn, button.start-btn, button.new-chat, button[type=\"submit\"]",
    "message_history": "#messages, .messages, .chat-box, .chat-messages, .logbox, main",
    "message_row": ".message, .msg, .chat-msg, .logitem, li",
    "message_text": ".text, .msg-text, p, span",
    "partner_message_selector": ".stranger, .incoming, .partner, .other, .left",
    "own_message_selector": ".you, .outgoing, .self, .me, .right",
    "partner_name": ".stranger-name, .partner-name",
    "chat_ended_text": "stranger has disconnected|partner left|chat ended|disconnected"
  }
}